# One Postgres instance; each service owns a private schema inside it.
AUTH_DATABASE_URL=postgresql://payflow:payflow@localhost:5433/payflow?schema=auth
WALLET_DATABASE_URL=postgresql://payflow:payflow@localhost:5433/payflow?schema=wallet
NOTIFICATION_DATABASE_URL=postgresql://payflow:payflow@localhost:5433/payflow?schema=notification
MOMO_DATABASE_URL=postgresql://payflow:payflow@localhost:5433/payflow?schema=momo

# Auth
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=3600

# Gateway
GATEWAY_PORT=3000

# Service endpoints
AUTH_HOST=localhost
AUTH_PORT=4001
WALLET_HOST=localhost
WALLET_PORT=4002
NOTIFICATION_HOST=localhost
NOTIFICATION_PORT=4003
MOMO_HOST=localhost
MOMO_PORT=4004

RPC_TIMEOUT_MS=5000

# Gateway edge policy
# Empty CORS_ORIGINS = no cross-origin browser access. Set a comma-separated
# list of exact origins to let a frontend in, e.g. http://localhost:5173
CORS_ORIGINS=
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
# Tighter budget for /auth/register and /auth/login
THROTTLE_AUTH_TTL_MS=60000
THROTTLE_AUTH_LIMIT=10
